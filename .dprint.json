{
    "lineWidth": 320,
    "newLineKind": "lf",
    "excludes": [
        ".venv/**",
        "node_modules/**"
    ],
    "markdown": {
        "list.indentKind": "pythonMarkdown",
        "textWrap": "always",
        "codeBlock.indentWidth": 2,
        "table.cellPadding": "align",
        "emphasisKind": "underscores",
        "strongKind": "asterisks",
        "list.unorderedMarker": "dashes"
    },
    "plugins": [
        "https://plugins.dprint.dev/markdown-0.28.0.wasm"
    ]
}
